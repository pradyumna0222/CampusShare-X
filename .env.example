# CampusShare X Configuration
# Copy this file to .env for local development. Never commit real secrets to source control.

NODE_ENV=development
PORT=3001

# PostgreSQL Connection String (Neon Free or local PostgreSQL)
# Format: postgresql://[user]:[password]@[neon-hostname]/[database]?sslmode=require
# If omitted during local tests, the system will seamlessly run self-contained embedded PostgreSQL (PGlite).
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_SSL=true
DB_POOL_MAX=10

# Timezone settings (Asia/Kolkata = UTC+5:30)
APP_TIMEZONE=Asia/Kolkata
BOOKING_TIMEZONE_OFFSET_MINUTES=330

# Seeding flags
SEED_INITIAL_ACCOUNTS=true
SEED_INITIAL_RESOURCES=true

# Initial seeded credentials (change in production - minimum 12 characters required for passwords)
INITIAL_STUDENT_EMAIL=student@campusshare.local
INITIAL_STUDENT_PASSWORD=CampusStudent!2026
INITIAL_STUDENT2_EMAIL=student2@campusshare.local
INITIAL_STUDENT2_PASSWORD=CampusStudent2!2026
INITIAL_OWNER_EMAIL=owner@campusshare.local
INITIAL_OWNER_PASSWORD=CampusOwner!2026
INITIAL_ADMIN_EMAIL=admin@campusshare.local
INITIAL_ADMIN_PASSWORD=CampusAdmin!2026

# Optional SmartMatch LLM enrichment (deterministic rule-based fallback works if empty)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
