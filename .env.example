# Local development configuration. Copy to .env; never commit real secrets.
NODE_ENV=development
PORT=3001
DATA_DIR=./data
APP_TIMEZONE=Asia/Kolkata
BOOKING_TIMEZONE_OFFSET_MINUTES=330
SEED_INITIAL_ACCOUNTS=true
SEED_INITIAL_RESOURCES=true

# LOCAL-ONLY seeded credentials. Change all passwords before a public deployment.
INITIAL_STUDENT_EMAIL=student@campusshare.local
INITIAL_STUDENT_PASSWORD=CampusStudent!2026
INITIAL_STUDENT2_EMAIL=student2@campusshare.local
INITIAL_STUDENT2_PASSWORD=CampusStudent2!2026
INITIAL_OWNER_EMAIL=owner@campusshare.local
INITIAL_OWNER_PASSWORD=CampusOwner!2026
INITIAL_ADMIN_EMAIL=admin@campusshare.local
INITIAL_ADMIN_PASSWORD=CampusAdmin!2026

# Optional SmartMatch language-model enrichment. Key stays server-side; do not use VITE_ prefix.
# The deterministic capability-matching fallback works when no key is configured.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
